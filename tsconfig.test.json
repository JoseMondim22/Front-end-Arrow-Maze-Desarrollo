{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "node16",
    "isolatedModules": true,
    "noEmit": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "@domain/*": ["src/domain/*"],
      "@mothers/*": ["test/domain/_mothers/*"],
      "@application/*": ["src/application/*"],
      "@app-mothers/*": ["test/application/_mothers/*"],
      "@testing-apis/*": ["test/application/_testing-apis/*"]
    }
  },
  "include": ["src", "test"],
  "exclude": [
    "src/ui",
    "src/infrastructure"
  ]
}
